# Ethereum network
# Local Anvil example: http://127.0.0.1:8545, chain id 31337
# Sepolia example: https://sepolia.infura.io/v3/YOUR_KEY, chain id 11155111
ETH_RPC_URL=http://127.0.0.1:8545
CHAIN_ID=31337
CHAIN_NAME=anvil

# Deployer/owner private key. Never commit a real private key.
DEPLOYER_PRIVATE_KEY=replace_with_demo_or_sepolia_private_key

# Contract address after deploy
HEALTHCARE_EHR_ADDRESS=

# IPFS provider: local or pinata
# local is a mock content-addressed store under storage/local_ipfs for offline development.
IPFS_PROVIDER=local
PINATA_JWT=
PINATA_GATEWAY=https://gateway.pinata.cloud/ipfs

# Base64-encoded 32-byte AES-GCM key. Generate with:
# python -m backend.crypto generate-key
EHR_ENCRYPTION_KEY_BASE64=

# FastAPI
APP_HOST=127.0.0.1
APP_PORT=8000
